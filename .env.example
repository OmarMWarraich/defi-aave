# Copy this file to .env and fill in real values. Never commit .env.

# --- RPC endpoints ---
# Used for forking mainnet in tests and for deployments.
# Get one from Alchemy, Infura, or any node provider.
MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_KEY
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY

# Pin a block number for deterministic mainnet-fork tests (optional but recommended).
FORK_BLOCK_NUMBER=

# --- Deployment ---
# Private key of the deployer account. Use a throwaway/test key only.
DEPLOYER_PRIVATE_KEY=

# --- Verification ---
# API key for contract verification on Etherscan (and compatible explorers).
ETHERSCAN_API_KEY=

# --- Frontend (Vite exposes only VITE_-prefixed vars to the client) ---
VITE_CHAIN_ID=1
VITE_RPC_URL=
# WalletConnect Cloud project id (required by RainbowKit / Web3Modal).
VITE_WALLETCONNECT_PROJECT_ID=
